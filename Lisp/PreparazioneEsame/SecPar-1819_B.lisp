(defun aggiungi1 (lista)
    (cond ((null lista) NIL)
          ((numberp lista)
            (if (oddp lista)
                (1+ lista)
                lista))
          (T (append (list (aggiungi1 (first lista)))
                     (aggiungi1 (rest lista))))))

(defun what (l1 l2)
    (cond ((null l1) 0)
          ((null l2) 0)
          ((member (car l1) l2)
            (+ 1 (what (cdr l1) l2)))
          (T (what (cdr l1) l2))))