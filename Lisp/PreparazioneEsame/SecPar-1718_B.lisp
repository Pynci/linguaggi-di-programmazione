(defun quadrato (x)
    (* x x))

(defun mistery (e n list)
    (cond ((zerop n) (cons e list))
          ((null list) (list e))
          (T (cons (car list) (mistery e (- n 1) (rest list))))))

(defun aggiungi-42 (x)
    (+ 42 x))

(defun adder (lista)
    (cond ((null lista) NIL)
          ((atom lista)
            (if (evenp lista)
                (aggiungi-42 lista)
                lista))
          (T (append (list (adder (first lista)))
                     (adder (rest lista))))))

(defun f-let (x y)
    (let ((a (+ x (* x y)))
          (b (* 4 y)))
        (lambda (y x)
            (+ (* x a)
               (* y (quadrato b))
               (* a b)))))

(defun f-lambda (x y)
    ((lambda (a b)
        (lambda (y x)
            (+ (* x a)
               (* y (quadrato b))
               (* a b))))
    (+ x (* x y))
    (* 4 y)))